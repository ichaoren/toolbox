from transformers import AutoProcessor
from vllm import LLM, SamplingParams
from qwen_vl_utils import process_vision_info

import os
#os.environ["VLLM_TORCH_PROFILER_DIR"] = './profile'     #指明profiling生成路径
os.environ['DEBUG_SUBPROCESS'] = '1'

# MODEL_PATH = "/mnt/nfs/y00899528/GLM-4.5V"
MODEL_PATH = "/home/Test/model/Qwen3-VL-32B-quant/"
#MODEL_PATH = "/home/Test/model/Qwen3-VL-32B-Instruct/"

llm = LLM(
    model=MODEL_PATH,
    tensor_parallel_size=2,
    # mm_parallel_size=2,
    # ring_parallel_size=2,
    #enable_expert_parallel=True,
    max_model_len=16384,
    enable_prefix_caching=False,
    disable_mm_preprocessor_cache=True,
    compilation_config={"cudagraph_mode": "FULL_DECODE_ONLY"},
    mm_processor_cache_type="shm",
    quantization="ascend",
    #enforce_eager=True,
    limit_mm_per_prompt={"image": 10, "video": 10}
    # limit_mm_per_prompt={"image": 10},
)

sampling_params = SamplingParams(
    max_tokens=5
)
#image


image_messages = [
    {"role": "system", "content": "You are a helpful assistant."},
    {
        "role": "user",
        "content": [
            {
                "type": "image",
                "image": "./480p.png",
                "max_pixels": 1280 * 28 * 28,
                "min_pixels":  224 * 224
            },
            {"type": "text", "text": "Please provide a detailed description of this image"},
        ],
    },
]



# video input
'''
video_path = "/mnt/nfs/y00899528/qwen3vl_vllm/script/v_-8SgY4vW4xM.mp4"
image_messages = [
    {"role": "system", "content": "You are a helpful assistant."},
    {
        "role": "user",
        "content": [
            {
                "type": "video",
                "video": "file:///" + video_path,
                "total_pixels": 20480 * 28 * 28,
                "min_pixels": 16 * 28 * 28
            },
            {"type": "text", "text": "Please provide a detailed description of this video"},
        ],
    },
]
'''
messages = image_messages

processor = AutoProcessor.from_pretrained(MODEL_PATH)
prompt = processor.apply_chat_template(
    messages,
    tokenize=False,
    add_generation_prompt=True,
)

image_inputs, _ = process_vision_info(messages)
#image_inputs, _, _ = process_vision_info(messages, return_video_kwargs=True)
# image_inputs, video_inputs = process_vision_info(messages)

mm_data = {}
if image_inputs is not None:
    mm_data["image"] = image_inputs

# if video_inputs is not None:
#     mm_data["video"] = video_inputs

llm_inputs = {
    "prompt": prompt,
    "multi_modal_data": mm_data,
}
for i in range(5):
    if i == 4:
        llm.start_profile()
    outputs = llm.generate([llm_inputs], sampling_params=sampling_params)
    if i == 4:
        llm.stop_profile()
generated_text = outputs[0].outputs[0].text
print(generated_text)

